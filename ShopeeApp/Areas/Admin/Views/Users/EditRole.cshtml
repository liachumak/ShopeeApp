@model ShopeeApp.Areas.Admin.Models.EditUserRoleViewModel

@{
    ViewData["Title"] = "Редагування ролей";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>Редагування ролей для @Model.Email</h5>
    </div>

    <div class="card-body">
        <form asp-action="EditRole" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Роль</th>
                        <th>Призначена</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Roles[i].RoleName
                                <input type="hidden" name="Roles[@i].RoleName" value="@Model.Roles[i].RoleName" />
                            </td>
                            <td class="text-center">
                                <input type="checkbox" name="Roles[@i].IsSelected" value="true" @(Model.Roles[i].IsSelected ? "checked" : "") />
                                <input type="hidden" name="Roles[@i].IsSelected" value="false" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button type="submit" class="btn btn-primary">💾 Зберегти</button>
            <a asp-action="Index" class="btn btn-secondary">⬅️ Назад</a>
        </form>
    </div>
</div>
