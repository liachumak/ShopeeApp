@model IEnumerable<ShopeeApp.Models.ApplicationUser>

@{
    ViewData["Title"] = "Список користувачів";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>Список користувачів</h5>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Фото</th>
                    <th>Ім'я користувача</th>
                    <th>Email</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="text-center">
                            <img src="@(string.IsNullOrEmpty(user.ProfileImageUrl) ? Url.Content("~/images/default-avatar.png") : user.ProfileImageUrl)"
                                 alt="Фото користувача"
                                 class="rounded-circle border border-secondary"
                                 width="50" height="50" />
                        </td>
                        <td>@(user.FullName)</td>
                        <td>@user.Email</td>
                        <td>
                            <a asp-action="EditRole" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Ролі</a>
                            <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Ви впевнені, що хочете видалити цього користувача?');">
                                <button type="submit" class="btn btn-sm btn-danger">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
